# Public origin for R2 JSON (custom domain or public bucket URL). No trailing slash.
# Leave unset to use bundled fixtures in /data-fixtures for local dev.
#
# Option A: R2.dev public URL (dev/testing)
# VITE_R2_BASE_URL=https://pub-54ef12fcdfd4409d817c7b9e00d3d202.r2.dev
#
# Option B: Custom domain (production) — your Cloudflare DNS already points
# www.genegulanesjr.com → pcparts R2 bucket (Proxied). Use this for prod.
# VITE_R2_BASE_URL=https://www.genegulanesjr.com
VITE_R2_BASE_URL=
